# --- Claude Code local state -------------------------------------------
# This repo's own dev-time Claude config is not a deliverable (the plugin
# ships from skills/). Ignore all of .claude/ except a
# deliberately-shared settings.json for people working ON this repo.
# Runtime lock/state files are also covered by .git/info/exclude locally.
.claude/*
!.claude/settings.json

# --- Eval review artifacts --------------------------------------------
# review.html is a build artifact — it embeds a copy of every run's output
# files and regenerates from benchmark.json + the run dirs + the viewer
# template. feedback.json is transient per-iteration viewer state.
eval-workspace/**/review.html
eval-workspace/**/feedback.json

# --- Tooling / OS cruft -----------------------------------------------
node_modules/
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
